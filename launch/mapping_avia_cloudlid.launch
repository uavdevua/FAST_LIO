<launch>
<!-- Launch file for Livox AVIA LiDAR -->

	<arg name="rviz" default="false" />
	<arg name="rqt" default="true" />

	<rosparam command="load" file="$(find fast_lio)/config/avia_cloudlid.yaml" />

    <node pkg="fast_lio" type="fastlio_mapping" name="laserMapping" output="screen" /> 

	<group if="$(eval arg('rviz') == true or arg('rqt') == true)">
		<node if="$(arg rviz)" launch-prefix="nice" pkg="rviz" type="rviz" name="rviz" args="-d $(find fast_lio)/rviz_cfg/loam_livox.rviz" />
		<node unless="$(arg rviz)" launch-prefix="nice" pkg="rqt_gui" type="rqt_gui" name="rqt" args="--perspective-file $(find fast_lio)/rqt_cfg/cloudlid.perspective" />
	</group>

</launch>
